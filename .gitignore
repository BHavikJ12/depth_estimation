# ---- virtualenvs -------------------------------------------------------
# Never commit these. They are gigabytes, they are built for one CPU
# architecture, and every script inside hard-codes an absolute path, so a
# copied venv breaks the moment the folder moves. Each project's setup.sh
# rebuilds one in a single command.
venv/
.venv/
env/

# ---- model weights -----------------------------------------------------
# Fetched on first run, or by a download script. See README.md.
models/
*.onnx
*.hef
*.pt
*.pth
*.tflite
*.engine

# ---- test footage and outputs ------------------------------------------
testdata/
outputs/
captures/
*.mp4
*.MOV
*.mov
*.avi
*.mkv
*.webm

# ---- generated by the test suites --------------------------------------
selftest_hud.png
selftest_pipeline.png
*_track.csv
*_out.mp4

# ---- third-party repositories ------------------------------------------
# Upstream projects, cloned separately. Clone commands are in README.md;
# committing them here would vendor someone else's git history.
Fast-FoundationStereo/
HITNET-Stereo-Depth-estimation/
manual_align_depth_to_color/

# ---- python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- editors and OS ----------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
