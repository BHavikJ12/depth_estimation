[Unit]
Description=Drone detection and ranging (Hailo backend)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/depth_estimation/monoculer_camera_yolo
ExecStart=/home/pi/depth_estimation/monoculer_camera_yolo/venv/bin/python run.py \
    --source 0 --backend hailo --weights drone.hef \
    --keep-classes 1 --conf 0.40 --hfov 70 \
    --no-display --web-port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
